<% streak_icon =
  if @statistics[:current_streak][:type] == :win
    tag.i(class: "bi bi-trophy-fill text-warning")
  else
    tag.span do
      tag.i(class: "bi bi-graph-down-arrow text-danger me-1") +
      tag.i(class: "bi bi-emoji-frown text-danger")
    end
  end
%>

<div class="row g-3 mb-2">
  <div class="col-sm-6 col-xl-2">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Current streak <%= streak_icon %></div>
        <div class="fs-4 fw-semibold"><%= @statistics[:current_streak][:count] %></div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-2">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Longest winning streak</div>
        <div class="">
          <span class="fs-4 fw-bold pe-1">
            <%= @statistics[:longest_winning_streak][:length] %>
          </span>
          <%= render partial: "streak_range", collection: @statistics[:longest_winning_streak][:runs] %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-2">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Longest losing streak</div>
        <div class="">
          <span class="fs-4 fw-bold" pe-1>
            <%= @statistics[:longest_losing_streak][:length] %>
          </span>
          <%= render partial: "streak_range", collection: @statistics[:longest_losing_streak][:runs] %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-2">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Tournaments/boards</div>
        <div class="">
          <span class="fs-4 fw-bold" pe-1>
            <%= @statistics[:tournament_count] %>
          </span>
          <span class="badge bg-light text-dark border">
            <%= @statistics[:board_count] %>
          </span>
        </div>
      </div>
    </div>
  </div>

</div>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-2">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Highest score</div>
          <span class="fs-4 fw-bold" pe-1>
          <%= format_score(@statistics[:highest_score][:score]) %>
          </span>
          <span class="badge bg-light text-dark border">
            <%= @statistics[:highest_score][:number] %>
          </span>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-2">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Lowest score</div>
          <span class="fs-4 fw-bold" pe-1>
          <%= format_score(@statistics[:lowest_score][:score]) %>
          </span>
          <span class="badge bg-light text-dark border">
            <%= @statistics[:lowest_score][:number] %>
          </span>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-2">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Average Score</div>
        <div class="fs-4 fw-bold"><%= format_score(@statistics[:average_score]) %></div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-2">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Win Rate</div>
        <div class="fs-4 fw-bold"><%= format_score(@statistics[:win_rate]) %></div>
      </div>
    </div>
  </div>
</div>