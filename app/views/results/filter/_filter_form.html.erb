<div class="mb-2 canvas gray100-canvas embossed"">
  <div class="filter">
    <%= form_with url: results_path, method: :get, data: { controller: "filter" } do |form| %>

      <div class="form-check form-switch">
        <%= form.check_box :full_team,
              { checked: params[:full_team].present?,
                class: "form-check-input",
                onchange: "this.form.submit();" },
              "1", nil %>

        <%= form.label :full_team, "both Rob & Gav playing", class: "form-check-label" %>
      </div>
    <% end %>
  </div>
</div>