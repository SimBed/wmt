<div class="mb-2 canvas gray100-canvas embossed"">

    <%= form_with url: results_path, method: :get, data: { controller: "filter" } do |form| %>

  <div class="d-flex gap-3">
    <div class="form-check">
      <%= form.radio_button :full_team, "both",
            checked: params[:full_team] != "all",
            class: "form-check-input",
            onchange: "this.form.submit();" %>
      <%= form.label :full_team_both, "Rob & Gav only", class: "form-check-label" %>
    </div>

    <div class="form-check">
      <%= form.radio_button :full_team, "all",
            checked: params[:full_team] == "all",
            class: "form-check-input",
            onchange: "this.form.submit();" %>
      <%= form.label :full_team_all, "All results", class: "form-check-label" %>
    </div>
    </div>



    <% end %>

</div>